# Copy to Railway env vars (or a local .env). All optional — the service runs on the native RH RPC with no key.

# HTTP RPC for all bulk reading. If unset, the native Robinhood-chain public RPC is used (free, no key —
# verified to serve 10k-block eth_getLogs ranges). Set to an Alchemy URL only if you want the enhanced
# getAssetTransfers path instead; the code auto-detects Alchemy vs a generic node from the URL.
# You can give a COMMA-SEPARATED list (primary first, then fallbacks) for redundancy — requests rotate across
# them on retry so one endpoint's throttle/outage doesn't take the product down. Fallbacks should be the same
# provider kind as the primary (all generic, or all Alchemy). The native RH node is always appended as a
# last-resort fallback when the primary is a generic node.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WebSocket RPC for the true push live-tail (eth_subscribe). Native nodes usually don't expose this, so point
# it at an Alchemy/other WSS URL. If unset, the live tail falls back to HTTP polling. This is the ONE thing
# worth keeping a (free-tier) Alchemy key around for once RPC_URL is the native node.
RPC_WS=

# generic-RPC eth_getLogs tuning (ignored on Alchemy). The RH node serves ~10k-block spans and caps results at
# 10k logs; getTransferLogs walks in LOGS_RANGE spans, gaps LOGS_GAP_MS between calls (burst throttle), and
# auto-halves any span that overflows. Defaults are tuned for the RH chain — leave unless you see throttling.
LOGS_RANGE=8000
LOGS_GAP_MS=120

# Chain label (cosmetic + future multi-chain). e.g. robinhood | ethereum | base
CHAIN=robinhood

# How often the live tail polls for new blocks (ms) when RPC_WS is unset. Lower = snappier, more RPC calls.
POLL_MS=6000

# Discover-board refresh cadence (ms) and how many tokens to verdict per refresh.
BOARD_REFRESH_MS=180000
BOARD_ACTIVE=16
BOARD_GRAD=10

# Port (Railway sets this automatically).
PORT=8080

# --- access gate (not yet enforced) ---
# ERC-20 the visitor must hold to use the scanner, and the minimum balance.
ACCESS_TOKEN=
ACCESS_MIN=0
