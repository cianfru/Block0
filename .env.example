# Copy to Railway env vars (or a local .env). All optional — the POC runs with public RPC and no gate.

# Your RPC endpoint. Public drpc is used if unset. Set to your Alchemy/QuickNode HTTPS URL for reliability.
RPC_URL=

# WebSocket RPC for true push tailing (production upgrade). If unset, the server tails by polling.
RPC_WS=

# Chain label (cosmetic + future multi-chain). e.g. ethereum | base | robinhood
CHAIN=ethereum

# How often the live tail polls for new blocks (ms). Lower = snappier, more RPC calls.
POLL_MS=6000

# Port (Railway sets this automatically).
PORT=8080

# --- access gate (not yet enforced in the POC) ---
# ERC-20 the visitor must hold to use the scanner, and the minimum balance.
ACCESS_TOKEN=
ACCESS_MIN=0
