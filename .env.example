# Copy to Railway env vars (or a local .env). All optional — the service runs on the native RH RPC with no key.

# HTTP RPC for all bulk reading. If unset, the native Robinhood-chain public RPC is used (free, no key —
# verified to serve 10k-block eth_getLogs ranges). Set to an Alchemy URL only if you want the enhanced
# getAssetTransfers path instead; the code auto-detects Alchemy vs a generic node from the URL.
# You can give a COMMA-SEPARATED list (primary first, then fallbacks) for redundancy — requests rotate across
# them on retry so one endpoint's throttle/outage doesn't take the product down. Fallbacks should be the same
# provider kind as the primary (all generic, or all Alchemy). The native RH node is always appended as a
# last-resort fallback when the primary is a generic node.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WebSocket RPC for the true push live-tail (eth_subscribe). Native nodes usually don't expose this, so point
# it at an Alchemy/other WSS URL. If unset, the live tail falls back to HTTP polling. This is the ONE thing
# worth keeping a (free-tier) Alchemy key around for once RPC_URL is the native node.
RPC_WS=

# generic-RPC eth_getLogs tuning (ignored on Alchemy). The RH node serves ~10k-block spans and caps results at
# 10k logs; getTransferLogs walks in LOGS_RANGE spans, gaps LOGS_GAP_MS between calls (burst throttle), and
# auto-halves any span that overflows. Defaults are tuned for the RH chain — leave unless you see throttling.
LOGS_RANGE=8000
LOGS_GAP_MS=120

# Chain label (cosmetic + future multi-chain). e.g. robinhood | ethereum | base
CHAIN=robinhood

# How often the live tail polls for new blocks (ms) when RPC_WS is unset. Lower = snappier, more RPC calls.
POLL_MS=6000

# Discover-board refresh cadence (ms) and how many tokens to verdict per refresh.
BOARD_REFRESH_MS=180000
BOARD_ACTIVE=16
BOARD_GRAD=10

# Port (Railway sets this automatically).
PORT=8080

# --- access gate (not yet enforced) ---
# ERC-20 the visitor must hold to use the scanner, and the minimum balance.
ACCESS_TOKEN=
ACCESS_MIN=0

# ── Launch alerts (Telegram) ──────────────────────────────────────────────────────────────────────
# Push a message when a fresh, CLEAN, on-winner-pace launch appears. Dormant unless BOTH are set.
# 1. Create a bot: message @BotFather on Telegram → /newbot → copy the token.
# 2. Add the bot to your channel/group as an admin (or DM it), then get the chat id (e.g. via @userinfobot,
#    or a channel id like -1001234567890). Test the wiring by hitting /api/alerts/scan once it's deployed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public base URL used in alert links (defaults to the Railway URL).
PUBLIC_URL=
# Alert bar (all optional — defaults come from the winner-vs-loser separation study):
# ALERT_MIN_AGE_H=0.5   skip the first ~30 min (measured coin-flip window)
# ALERT_MAX_AGE_H=24    still a fresh catch
# ALERT_MAX_RISK=40     must read clean-ish
# ALERT_MIN_BLUEPRINT=60  partial fit or better (or corridor on-track)
# ALERT_MIN_HOLDERS=40  real adoption
# ALERT_SCAN=14         newest tokens verdicted per pass
# ALERT_INTERVAL_MS=120000

# Block explorer base URL for the Robinhood Chain (e.g. https://explorer.chain.robinhood.com). When set, wallet
# and deployer addresses on the token page link to <EXPLORER_URL>/address/0x… ; unset = addresses stay copyable.
EXPLORER_URL=

# Durable storage for alerts + track record (optional). Set an Upstash / Vercel KV REST pair for persistence
# across redeploys; otherwise a local JSON file under DATA_DIR is used (durable only on a mounted volume).
KV_REST_API_URL=
KV_REST_API_TOKEN=
DATA_DIR=./data

# ── DEX discovery (non-Pons listings on the Uniswap-v4 AMM) ────────────────────────────────────────
# Wide log scans use a dedicated RPC — the native RH node serves 10k-block ranges (Alchemy's free tier
# caps eth_getLogs at 10 blocks). Leave as the native node unless you have a better wide-getLogs endpoint.
DEX_RPC=https://rpc.mainnet.chain.robinhood.com
# The RH singleton AMM (Uniswap v4 PoolManager). Discovery watches its Initialize (pool-creation) events.
DEX_AMM=0x8366a39cc670b4001a1121b8f6a443a643e40951
BOARD_DEX=10          # non-Pons DEX tokens to verdict per DEX pass (0 disables DEX entirely)
DEX_MIN_HOLDERS=5     # spam floor — a discovered pool needs at least this many holders to make the board
DEX_BLOCKS=80000      # how far back to scan for recent listings each pass
DEX_REFRESH_MS=300000 # DEX discovery interval (decoupled from the Pons board)
DEX_EXCLUDE=          # extra infra/wrapper token addresses to strip from DEX discovery (comma-separated)

# ── Bubble map — common-funder pass (opt-in, the only Alchemy cost on the map) ─────────────────────
# Wallets funded from the same source = likely one operator. Resolved only on GET /api/graph?funders=1,
# bounded to the top N wallets, one getAssetTransfers each, cached FOREVER (a funder never changes).
FUNDER_CAP=40         # hard ceiling on per-wallet funder lookups per token (keep it low — cost discipline)
FUNDER_MAX_FANOUT=6   # a funder seeding more than this many of our wallets is an exchange/faucet → not clustered

# ── Wallet identity links (front-end cards) ────────────────────────────────────────────────────────
ZERION_URL=https://app.zerion.io   # a wallet card opens ${ZERION_URL}/{address} (Zerion supports the RH chain)
EXPLORER_URL=                      # RH-chain block explorer base; when set, wallet/contract links activate

# ── Token-gated access (EVM wallet balance check) ──────────────────────────────────────────────────
# The gate is OPEN until GATE_TOKEN is set — the whole site works. Set these post-launch to wall the
# product pages (board / dossier / leaderboard) behind holding the Block0 token. Connect reads the
# wallet address only (no signing); the balance is checked server-side against the token's chain.
GATE_TOKEN=            # the Block0 token contract address (0x…); unset = gate open
GATE_SYMBOL=BLOCK0     # ticker shown in the access UI
GATE_THRESHOLD=1000000 # whole tokens required to access
GATE_DECIMALS=18       # token decimals
GATE_CHAIN_RPC=        # RPC to read balanceOf on (defaults to the native RH node)
GATE_CHAIN_NAME=Robinhood Chain
GATE_BUY_URL=          # where a visitor buys the token (shown as "Get the token")

# ── Forensic analytics + control panel (/control) ──────────────────────────────────────────────────
CONTROL_PASSWORD=      # required to open /control (the forensic dashboard); unset = dashboard disabled
INTEL_SALT=block0-intel# salt for hashing visitor IPs (never stores raw IPs; rotate to reset unique counts)
INTEL_GEO=1            # 1 = best-effort cached IP geo when no edge header present; 0 = off. Put Cloudflare in
                       # front for reliable cf-ipcountry and this stays unused.
DATA_DIR=./data        # file-KV path. EPHEMERAL on Railway without a volume — connect Redis/Upstash (KV_REST_API_*)
                       # or mount a volume for durable analytics across redeploys.
